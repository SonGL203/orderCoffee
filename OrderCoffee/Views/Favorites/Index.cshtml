@model List<Product>
@{ ViewData["Title"] = "Món yêu thích"; }
<h3 class="mb-3">♥ Món yêu thích</h3>
@if (!Model.Any()) { <p class="text-muted">Bạn chưa lưu món nào. Bấm ♥ trên <a href="/menu">thực đơn</a> để lưu.</p> }
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card product-card h-100 @(p.IsAvailable ? "" : "sold-out")">
                <div class="emoji position-relative">@p.Category?.Icon<button type="button" class="fav-btn on" data-fav="@p.Id" title="Bỏ yêu thích">♥</button></div>
                <div class="card-body d-flex flex-column">
                    <h6 class="mb-1">@p.Name</h6>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="price">@Fmt.Money(p.Price)</span>
                        @if (p.IsAvailable)
                        {
                            <form method="post" asp-controller="Cart" asp-action="Add" asp-route-returnUrl="/favorites">
                                <input type="hidden" name="productId" value="@p.Id" />
                                <button class="btn btn-sm btn-coffee">+ Thêm</button>
                            </form>
                        }
                        else { <span class="badge text-bg-secondary">Hết hàng</span> }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
