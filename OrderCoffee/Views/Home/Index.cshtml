@{
    ViewData["Title"] = "Trang chủ";
    var featured = (List<Product>)ViewBag.Featured;
    var vouchers = (List<Voucher>)ViewBag.Vouchers;
}

<div class="hero mb-4">
    <h1 class="fw-bold">Cà phê ngon, giao tận nơi ☕</h1>
    <p class="lead mb-4">Đặt online lấy tại quán hoặc giao hàng. Tích điểm mỗi đơn, đổi voucher thoải mái.</p>
    <a href="/menu" class="btn btn-warning btn-lg me-2">Đặt món ngay</a>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">Đăng ký nhận ưu đãi</a>
    }
</div>

<div class="row g-3 mb-4 text-center">
    <div class="col-md-4"><div class="card p-3 h-100"><div class="fs-1">📱</div><b>Đặt online</b><small class="text-muted">Chọn món, chọn lấy tại quán hoặc giao tận nơi, theo dõi đơn theo thời gian thực.</small></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="fs-1">🪑</div><b>Gọi món tại bàn</b><small class="text-muted">Quét QR trên bàn — không cần đăng nhập, nhân viên mang món ra tận nơi.</small></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="fs-1">🎁</div><b>Tích điểm đổi quà</b><small class="text-muted">10.000đ = 1 điểm. Đổi điểm lấy voucher giảm giá.</small></div></div>
</div>

<h4 class="mb-3">Món nổi bật</h4>
<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    @foreach (var p in featured)
    {
        <div class="col"><a href="/menu" class="text-decoration-none text-reset"><div class="card h-100 p-3 text-center"><b>@p.Name</b><span class="price">@Fmt.Money(p.Price)</span></div></a></div>
    }
</div>

@if (vouchers.Any())
{
    <h4 class="mb-3">Mã khuyến mãi đang chạy</h4>
    <div class="row g-3">
        @foreach (var v in vouchers)
        {
            <div class="col-md-4">
                <div class="card p-3 border-start border-4 border-warning">
                    <b>@v.Code</b>
                    <div>@v.Name</div>
                    <small class="text-muted">@v.DisplayValue@(v.MinOrder > 0 ? $" · đơn từ {Fmt.Money(v.MinOrder)}" : "") · HSD @v.EndAt.ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
    </div>
}
