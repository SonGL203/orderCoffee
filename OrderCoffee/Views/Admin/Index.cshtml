@{
    ViewData["Title"] = "Báo cáo";
    DateTime from = ViewBag.From, to = ViewBag.To;
    var daily = (List<(DateTime Day, int Revenue, int Orders)>)ViewBag.Daily;
    var top = (List<(string Name, int Qty, int Revenue)>)ViewBag.TopProducts;
    var max = Math.Max(1, daily.Max(d => d.Revenue));
}
<h3 class="mb-3">Báo cáo doanh thu</h3>
<form method="get" class="row g-2 mb-4">
    <div class="col-auto"><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-coffee">Xem</button></div>
</form>
<div class="row g-3 mb-4 text-center">
    <div class="col-6 col-md-3"><div class="card p-3"><small class="text-muted">Doanh thu</small><div class="fs-4 price">@Fmt.Money((int)ViewBag.Revenue)</div></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><small class="text-muted">Số đơn hoàn thành</small><div class="fs-4">@ViewBag.OrderCount</div><small>Online @ViewBag.OnlineCount · Tại bàn @ViewBag.DineInCount</small></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><small class="text-muted">Đã giảm giá</small><div class="fs-4">@Fmt.Money((int)ViewBag.DiscountTotal)</div></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><small class="text-muted">Khách hàng</small><div class="fs-4">@ViewBag.Customers</div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card p-3">
            <h5>Theo ngày</h5>
            @foreach (var d in daily)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <small style="width:50px">@d.Day.ToString("dd/MM")</small>
                    <div class="flex-fill bg-light rounded"><div class="rounded" style="height:18px;width:@(d.Revenue * 100 / max)%;background:var(--accent)"></div></div>
                    <small style="width:130px" class="text-end">@Fmt.Money(d.Revenue) (@d.Orders)</small>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3">
            <h5>Món bán chạy</h5>
            <table class="table table-sm mb-0">
                @foreach (var p in top) { <tr><td>@p.Name</td><td class="text-end">@p.Qty ly</td><td class="text-end">@Fmt.Money(p.Revenue)</td></tr> }
                @if (!top.Any()) { <tr><td class="text-muted">Chưa có dữ liệu</td></tr> }
            </table>
        </div>
    </div>
</div>
